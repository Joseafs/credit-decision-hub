{
  "name": "credit-decision-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.26.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "seed": "pnpm --filter @credit-decision-hub/api seed",
    "storybook": "pnpm --filter @credit-decision-hub/storybook dev",
    "storybook:build": "pnpm --filter @credit-decision-hub/storybook build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@credit-decision-hub/eslint-config": "workspace:*",
    "eslint": "^10.0.0",
    "prettier": "^3.9.0",
    "turbo": "^2.10.0",
    "typescript": "^6.0.0"
  }
}
